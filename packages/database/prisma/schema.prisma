generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  payload   Json
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model SenderEmail {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  replyTo     String?
  isActive    Boolean  @default(true)
  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt

  automations AudienceAutomation[]
}

model EmailTemplate {
  id             String   @id @default(cuid())
  name           String
  description    String?
  defaultSubject String
  defaultHtml    String
  languageBlocks Json     @default("{}")
  isActive       Boolean  @default(true)
  createdDate    DateTime @default(now())
  updatedDate    DateTime @updatedAt

  automations AudienceAutomation[]
}

model AudienceAutomation {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  sqlQuery           String
  subscriberKeyField String
  emailField         String
  languageField      String?
  senderEmailId      String
  emailTemplateId    String
  isActive           Boolean  @default(false)
  scheduleType       AutomationScheduleType @default(MANUAL)
  scheduleMinute     Int      @default(0)
  scheduleHour       Int?
  scheduleDayOfWeek  Int?
  scheduleDayOfMonth Int?
  scheduleTimezone   String   @default("Africa/Casablanca")
  scheduleStartAt    DateTime?
  scheduleEndAt      DateTime?
  nextRunAt          DateTime?
  lastRunAt          DateTime?
  createdDate        DateTime @default(now())
  updatedDate        DateTime @updatedAt

  senderEmail   SenderEmail    @relation(fields: [senderEmailId], references: [id])
  emailTemplate EmailTemplate  @relation(fields: [emailTemplateId], references: [id])
  runs          AutomationRun[]

  @@index([senderEmailId])
  @@index([emailTemplateId])
  @@index([isActive, nextRunAt])
}

model AutomationRun {
  id             String              @id @default(cuid())
  automationId   String
  status         AutomationRunStatus @default(RUNNING)
  audienceCount  Int                 @default(0)
  deliveredCount Int                 @default(0)
  failedCount    Int                 @default(0)
  dryRun         Boolean             @default(false)
  error          String?
  startedDate    DateTime            @default(now())
  completedDate  DateTime?
  startedBy      String?

  automation AudienceAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, startedDate])
}

model RecordFlow {
  id             String      @id @default(cuid())
  name           String
  description    String?
  sourceEntity   String
  trigger        FlowTrigger
  condition      Json?
  actions        Json
  isActive       Boolean     @default(false)
  lastRunDate    DateTime?
  lastError      String?
  createdDate    DateTime    @default(now())
  updatedDate    DateTime    @updatedAt

  @@index([sourceEntity, trigger, isActive])
}

model Product {
  id            String      @id @default(cuid())
  uniqueCode    String      @unique
  type          ProductType
  priceEuro     Float?
  order         Int?
  thumbnail     String
  titleFR       String?
  titleEN       String?
  titleDE       String?
  titleIT       String?
  titlePT       String?
  titleES       String?
  subtitleFR    String?
  subtitleEN    String?
  subtitleDE    String?
  subtitleIT    String?
  subtitlePT    String?
  subtitleES    String?
  priceTitleFR  String?
  priceTitleEN  String?
  priceTitleDE  String?
  priceTitleIT  String?
  priceTitlePT  String?
  priceTitleES  String?
  descriptionFR String?
  descriptionEN String?
  descriptionDE String?
  descriptionIT String?
  descriptionPT String?
  descriptionES String?
  addressFR     String?
  addressEN     String?
  addressDE     String?
  addressIT     String?
  addressPT     String?
  addressES     String?
  tagsFR        Json?
  tagsEN        Json?
  tagsDE        Json?
  tagsIT        Json?
  tagsPT        Json?
  tagsES        Json?
  detailsFR     Json?
  detailsEN     Json?
  detailsDE     Json?
  detailsIT     Json?
  detailsPT     Json?
  detailsES     Json?
  image1        String?
  image2        String?
  image3        String?
  image4        String?
  image5        String?
  image6        String?
  image7        String?
  image8        String?
  image9        String?
  image10       String?
  image11       String?
  image12       String?
  image13       String?
  image14       String?
  image15       String?
  image16       String?
  image17       String?
  image18       String?
  image19       String?
  image20       String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  image21       String?
}

model WhatsAppConversation {
  id             String            @id @default(cuid())
  whatsappPhone  String?
  whatsappUserId String?
  displayName    String?
  managedBy      WhatsAppManagedBy @default(AI)
  createdDate    DateTime          @default(now())
  updatedDate    DateTime          @updatedAt
  messages       WhatsAppMessage[]
}

model WhatsAppMessage {
  id                String                @id @default(cuid())
  conversationId    String
  sender            WhatsAppMessageSender
  message           String
  sentAt            DateTime              @default(now())
  externalMessageId String?
  conversation      WhatsAppConversation  @relation(fields: [conversationId], references: [id])
}

model Individual {
  id String @id

  firstName    String
  lastName     String
  email        String? @unique
  manualEmail  String? @unique
  mobilePhone  String?
  passwordHash String?

  googleId     String? @unique
  authProvider String  @default("EMAIL")

  address   String?
  birthdate DateTime?
  country   String?
  language  String
  source    String

  isActive      Boolean @default(false)
  emailVerified Boolean @default(false)

  emailVerificationToken          String?
  emailVerificationTokenExpiresAt DateTime?

  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  createdDate DateTime @default(now())
  createdBy   String?
  updatedDate DateTime @updatedAt
  updatedBy   String?

  lastSuccessfulLoginDate DateTime?

  leads           Lead[]
  prospects       Prospect[]
  accounts        Account[]
  consents        Consent[]
  pageVisits      PageVisit[]
  contactRequests ContactRequest[]
  chats           Chat[]
  visitorJourneys VisitorJourney[]

  @@index([email])
  @@index([manualEmail])
  @@index([passwordResetToken])
}

model Lead {
  id                String           @id
  firstName         String
  lastName          String
  email             String?
  mobilePhone       String?
  address           String?
  birthdate         DateTime?
  country           String?
  language          String
  source            String
  statusDescription String
  createdDate       DateTime         @default(now())
  createdBy         String?
  updatedDate       DateTime         @updatedAt
  updatedBy         String?
  individualId      String
  chats             Chat[]
  contactRequests   ContactRequest[]
  individual        Individual       @relation(fields: [individualId], references: [id])
  pageVisits        PageVisit[]
}

model Prospect {
  id                String           @id @default(cuid())
  firstName         String
  lastName          String
  email             String?
  mobilePhone       String?
  address           String?
  birthdate         DateTime?
  country           String?
  language          String
  source            String
  statusDescription String
  createdDate       DateTime         @default(now())
  createdBy         String?
  updatedDate       DateTime         @updatedAt
  updatedBy         String?
  individualId      String
  chats             Chat[]
  contactRequests   ContactRequest[]
  pageVisits        PageVisit[]
  individual        Individual       @relation(fields: [individualId], references: [id])
}

model Account {
  id                String           @id @default(cuid())
  firstName         String
  lastName          String
  email             String?
  mobilePhone       String?
  address           String?
  birthdate         DateTime?
  country           String?
  language          String
  source            String
  statusDescription String
  createdDate       DateTime         @default(now())
  createdBy         String?
  updatedDate       DateTime         @updatedAt
  updatedBy         String?
  individualId      String
  individual        Individual       @relation(fields: [individualId], references: [id])
  chats             Chat[]
  contactRequests   ContactRequest[]
  pageVisits        PageVisit[]
}

model Consent {
  id            String         @id @default(cuid())
  individualId  String
  channel       ConsentChannel
  channelStatus ChannelStatus  @default(UNKNOWN)

  createdDate DateTime @default(now())
  createdBy   String?
  updatedDate DateTime @updatedAt
  updatedBy   String?

  individual Individual @relation(fields: [individualId], references: [id], onDelete: Cascade)

  @@unique([individualId, channel])
  @@index([individualId])
}

model PageVisit {
  id           String       @id @default(cuid())
  pageUrl      String
  pageName     String?
  visitorId    String?
  journeyId    String?
  visitorStage VisitorStage
  leadId       String?
  prospectId   String?
  accountId    String?
  individualId String?
  visitDate    DateTime     @default(now())
  referrer     String?
  userAgent    String?
  ipAddress    String?
  sessionId    String?
  account      Account?     @relation(fields: [accountId], references: [id])
  individual   Individual?  @relation(fields: [individualId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])
  prospect     Prospect?    @relation(fields: [prospectId], references: [id])
  journey      VisitorJourney? @relation(fields: [journeyId], references: [id], onDelete: SetNull)

  @@index([visitorId])
  @@index([journeyId])
  @@index([individualId, visitDate])
}

model ContactRequest {
  id             String                @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  mobilePhone    String?
  requestType    RequestType
  subject        String?
  comment        String
  requesterStage ContactRequesterStage @default(VISITOR)
  individualId   String?
  leadId         String?
  prospectId     String?
  accountId      String?
  createdDate    DateTime              @default(now())
  createdBy      String?
  updatedDate    DateTime              @updatedAt
  updatedBy      String?
  account        Account?              @relation(fields: [accountId], references: [id])
  individual     Individual?           @relation(fields: [individualId], references: [id])
  lead           Lead?                 @relation(fields: [leadId], references: [id])
  prospect       Prospect?             @relation(fields: [prospectId], references: [id])
}

model Chat {
  id               String               @id @default(cuid())
  visitorId        String?
  journeyId        String?
  sessionId        String?
  leadId           String?
  prospectId       String?
  accountId        String?
  individualId     String?
  advisorId        String?
  participantStage ChatParticipantStage @default(VISITOR)
  managedBy        ChatManagedBy        @default(AI)
  status           ChatStatus           @default(OPEN)
  language         String               @default("en")
  endUserTypingUntil DateTime?
  advisorTypingUntil DateTime?
  createdDate      DateTime             @default(now())
  createdBy        String?
  updatedDate      DateTime             @updatedAt
  updatedBy        String?
  account          Account?             @relation(fields: [accountId], references: [id])
  advisor          User?                @relation(fields: [advisorId], references: [id])
  individual       Individual?          @relation(fields: [individualId], references: [id])
  lead             Lead?                @relation(fields: [leadId], references: [id])
  prospect         Prospect?            @relation(fields: [prospectId], references: [id])
  messages         ChatMessage[]
  journey          VisitorJourney? @relation(fields: [journeyId], references: [id], onDelete: SetNull)

  @@index([visitorId])
  @@index([journeyId])
  @@index([individualId])
  @@index([advisorId])
  @@index([updatedDate])
}

model VisitorJourney {
  id           String   @id
  visitorId    String
  individualId String?
  startedAt    DateTime @default(now())
  claimedAt    DateTime?
  endedAt      DateTime?
  lastSeenAt   DateTime @updatedAt

  individual Individual? @relation(fields: [individualId], references: [id], onDelete: SetNull)
  pageVisits PageVisit[]
  chats      Chat[]

  @@index([visitorId])
  @@index([individualId])
}

model ChatMessage {
  id         String         @id @default(cuid())
  chatId     String
  senderType ChatSenderType
  senderId   String?
  message    String
  sendTime   DateTime       @default(now())
  isRead     Boolean        @default(false)
  chat       Chat           @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, sendTime])
  @@index([chatId, isRead])
}

model User {
  id           String  @id @default(cuid())
  firstName    String
  lastName     String
  email        String  @unique
  passwordHash String
  mobilePhone  String?

  role     String
  isActive Boolean @default(true)

  lastLoginDate DateTime?

  createdDate DateTime @default(now())
  createdBy   String?
  updatedDate DateTime @updatedAt
  updatedBy   String?

  assignedChats Chat[]
}

enum ChannelStatus {
  OPTIN
  UNKNOWN
  OPTOUT
}

enum AutomationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum AutomationScheduleType {
  MANUAL
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

enum FlowTrigger {
  CREATED
  UPDATED
  DELETED
}

enum ConsentChannel {
  EMAIL
  SMS
  WHATSAPP
  PHONE
}

enum VisitorStage {
  LEAD
  PROSPECT
  ACCOUNT
  ANONYMOUS
}

enum RequestType {
  ADVISOR_GUIDE
  COMPLAINT
  SUPPORT
  PARTNERSHIP
  OTHER
}

enum ContactRequesterStage {
  VISITOR
  INDIVIDUAL
  LEAD
  PROSPECT
  ACCOUNT
}

enum ChatManagedBy {
  AI
  MANUAL
}

enum ChatStatus {
  OPEN
  CLOSED
  WAITING_FOR_VISITOR
  WAITING_FOR_ADVISOR
}

enum ChatParticipantStage {
  VISITOR
  INDIVIDUAL
  LEAD
  PROSPECT
  ACCOUNT
}

enum ChatSenderType {
  VISITOR
  INDIVIDUAL
  LEAD
  PROSPECT
  ACCOUNT
  ADVISOR
  AI
}

enum WhatsAppManagedBy {
  AI
  MANUAL
}

enum WhatsAppMessageSender {
  CUSTOMER
  ADVISOR
  AI
}

enum ProductType {
  VILLA
  SWIMMINGPOOL
  SPA
  RESTAURANT
  ACTIVITY
  TRANSPORTATION
}
