{
  "name": "MoorishConcierge",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",

    "dev:web": "npm --prefix apps/website run dev",
    "dev:web-api": "npm --prefix apps/website-api run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "dev:admin-api": "npm --prefix apps/admin-api run dev",

    "dev:website": "concurrently \"npm run dev:web\" \"npm run dev:web-api\"",
    "dev:backoffice": "concurrently \"npm run dev:admin\" \"npm run dev:admin-api\"",

    "dev": "concurrently --kill-others-on-fail --names \"WEB,WEB-API,ADMIN,ADMIN-API\" \"npm run dev:web\" \"npm run dev:web-api\" \"npm run dev:admin\" \"npm run dev:admin-api\"",

    "db:generate": "npm --prefix packages/database run generate",
    "db:migrate": "npm --prefix packages/database run migrate",
    "db:seed": "npm --prefix packages/database run seed",
    "db:test": "npm --prefix packages/database run test:db"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}