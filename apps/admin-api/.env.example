DATABASE_URL=postgresql://user:password@localhost:5432/moorish
PORT=8081
ADMIN_URL=http://localhost:8080

# Required. Generate a long random value (at least 32 characters).
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_ALT_MODEL=gpt-4.1-mini
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini

# One-time first administrator creation. Generate a random token of at least
# 32 characters, enable this only for the bootstrap request, then remove both
# variables (or set ENABLE_ADMIN_BOOTSTRAP=false) after the user is created.
ENABLE_ADMIN_BOOTSTRAP=false
BOOTSTRAP_ADMIN_TOKEN=replace-with-a-long-random-one-time-token

# One-time first administrator creation. Generate a random token of at least
# 32 characters, enable this only for the bootstrap request, then remove both
# variables (or set ENABLE_ADMIN_BOOTSTRAP=false) after the user is created.
ENABLE_ADMIN_BOOTSTRAP=false
BOOTSTRAP_ADMIN_TOKEN=replace-with-a-long-random-one-time-token

# Set to true only when the API runs behind a trusted reverse proxy.
TRUST_PROXY=false

# Browser/mobile notifications. This public key must match website-api.
VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key
VAPID_SUBJECT=mailto:contact@moorishconcierge.com

# Optional in the test version. Without it, automation email runs are dry runs.
RESEND_API_KEY=
# Copy the signing secret shown after creating the Resend webhook. The endpoint
# is https://YOUR-ADMIN-API/api/public/resend/webhook.
RESEND_WEBHOOK_SECRET=

# Concierge order payments. Keep both Stripe values server-side in admin-api.
# Use sk_test_ and a Stripe CLI whsec_ value locally; use separate secrets in
# staging and production.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PUBLIC_WEBSITE_URL=http://localhost:3000
PAYMENT_EMAIL_FROM=Moorish Concierge <contact@moorishconcierge.com>

# Cloudflare Images. Store real values only in .env or deployment secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_DELIVERY_HASH=
CLOUDFLARE_IMAGES_VARIANT=
