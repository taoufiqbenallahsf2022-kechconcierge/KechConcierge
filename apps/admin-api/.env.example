DATABASE_URL=postgresql://user:password@localhost:5432/moorish
PORT=8081
ADMIN_URL=http://localhost:8080

# Required. Generate a long random value (at least 32 characters).
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Set to true only when the API runs behind a trusted reverse proxy.
TRUST_PROXY=false

# Optional in the test version. Without it, automation email runs are dry runs.
RESEND_API_KEY=
