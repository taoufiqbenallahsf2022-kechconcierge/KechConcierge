DATABASE_URL=postgresql://user:password@localhost:5432/moorish
PORT=8081
ADMIN_URL=http://localhost:8080

# Required. Generate a long random value (at least 32 characters).
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_ALT_MODEL=gpt-4.1-mini
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini

# One-time first administrator creation. Generate a random token of at least
# 32 characters, enable this only for the bootstrap request, then remove both
# variables (or set ENABLE_ADMIN_BOOTSTRAP=false) after the user is created.
ENABLE_ADMIN_BOOTSTRAP=false
BOOTSTRAP_ADMIN_TOKEN=replace-with-a-long-random-one-time-token

# Set to true only when the API runs behind a trusted reverse proxy.
TRUST_PROXY=false

# Optional in the test version. Without it, automation email runs are dry runs.
RESEND_API_KEY=

# Cloudflare Images. Store real values only in .env or deployment secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_DELIVERY_HASH=
CLOUDFLARE_IMAGES_VARIANT=
